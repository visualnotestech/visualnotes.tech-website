{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://pagead2.googlesyndication.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://script.google.com https://*.supabase.co; frame-src 'self';"
        }
      ]
    },
    {
      "source": "/(.*).pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://www.visualnotes.tech/",
      "statusCode": 301
    },
    {
      "source": "/index",
      "destination": "https://www.visualnotes.tech/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "https://www.visualnotes.tech/",
      "statusCode": 301
    },
    {
      "source": "/blog/index.html",
      "destination": "https://www.visualnotes.tech/blog/",
      "statusCode": 301
    },
    {
      "source": "/blog/index",
      "destination": "https://www.visualnotes.tech/blog/",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "https://www.visualnotes.tech/blog/",
      "statusCode": 301
    },
    {
      "source": "/guides/index.html",
      "destination": "https://www.visualnotes.tech/guides/",
      "statusCode": 301
    },
    {
      "source": "/guides/index",
      "destination": "https://www.visualnotes.tech/guides/",
      "statusCode": 301
    },
    {
      "source": "/guides",
      "destination": "https://www.visualnotes.tech/guides/",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy.html",
      "destination": "https://www.visualnotes.tech/privacy",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy",
      "destination": "https://www.visualnotes.tech/privacy",
      "statusCode": 301
    },
    {
      "source": "/privacy.html",
      "destination": "https://www.visualnotes.tech/privacy",
      "statusCode": 301
    },
    {
      "source": "/terms.html",
      "destination": "https://www.visualnotes.tech/terms",
      "statusCode": 301
    },
    {
      "source": "/about.html",
      "destination": "https://www.visualnotes.tech/about",
      "statusCode": 301
    },
    {
      "source": "/faq.html",
      "destination": "https://www.visualnotes.tech/faq",
      "statusCode": 301
    },
    {
      "source": "/write-for-us.html",
      "destination": "https://www.visualnotes.tech/write-for-us",
      "statusCode": 301
    },
    {
      "source": "/socmint-flashcards.html",
      "destination": "https://www.visualnotes.tech/socmint-flashcards",
      "statusCode": 301
    },
    {
      "source": "/hsrp-flashcards.html",
      "destination": "https://www.visualnotes.tech/hsrp-flashcards",
      "statusCode": 301
    },
    {
      "source": "/subnetting-flashcards.html",
      "destination": "https://www.visualnotes.tech/subnetting-flashcards",
      "statusCode": 301
    },
    {
      "source": "/blog/:slug.html",
      "destination": "https://www.visualnotes.tech/blog/:slug",
      "statusCode": 301
    },
    {
      "source": "/(.*)\\.html",
      "destination": "https://www.visualnotes.tech/$1",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "visualnotes.tech"
        }
      ],
      "destination": "https://www.visualnotes.tech/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    }
  ]
}